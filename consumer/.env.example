# Base URL of the delivery API (the REST namespace root).
# Unset  -> the consumer serves the offline fixture in lib/fixture.ts.
# Set    -> the consumer fetches live data and validates it against the contract.
# The client appends /articles and /articles/{id} to this value.
DELIVERY_API_BASE_URL=https://your-wordpress-site.example/wp-json/hdp/v1
